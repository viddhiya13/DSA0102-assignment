#include <iostream>
#include <cstring>
using namespace std;

class Text {
private:
    char* data;

public:
    // Constructor
    Text(const char* text = "") {
        int length = strlen(text);

        data = new char[length + 1];

        strcpy(data, text);
    }

    // Copy constructor
    Text(const Text& other) {
        int length = strlen(other.data);

        data = new char[length + 1];

        strcpy(data, other.data);

        cout << "Copy Constructor Called" << endl;
    }

    // Copy assignment operator
    Text& operator=(const Text& other) {
        if (this != &other) {
            int length = strlen(other.data);

            char* newData = new char[length + 1];

            strcpy(newData, other.data);

            delete[] data;

            data = newData;
        }

        return *this;
    }

    // Destructor
    ~Text() {
        delete[] data;
    }

    // Addition operator
    Text operator+(const Text& other) const {
        int length1 = strlen(data);
        int length2 = strlen(other.data);

        char* combined = new char[length1 + length2 + 1];

        strcpy(combined, data);
        strcat(combined, other.data);

        Text result(combined);

        delete[] combined;

        return result;
    }

    // Equality operator
    bool operator==(const Text& other) const {
        return strcmp(data, other.data) == 0;
    }

    // Not equal operator
    bool operator!=(const Text& other) const {
        return !(*this == other);
    }

    // Output stream operator
    friend ostream& operator<<(ostream& out, const Text& text) {
        out << text.data;
        return out;
    }
};

int main() {
    Text t1("Hello");
    Text t2(" World");
    Text t3("!");

    // Concatenation
    Text result = t1 + t2 + t3;

    cout << "Combined Text: " << result << endl;

    // Copy constructor
    Text copied = result;

    cout << "Copied Text: " << copied << endl;

    // Empty text
    Text empty;

    cout << "Empty Text: [" << empty << "]" << endl;

