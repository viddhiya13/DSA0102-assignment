#include <iostream>
#include <string>
#include <vector>
using namespace std;

class Prescription {
private:
    int n;
    string* medicines;

public:
    explicit Prescription(int count)
        : n(count < 0 ? 0 : count),
          medicines(n > 0 ? new string[n] : nullptr) {}

    // Deep copy constructor
    Prescription(const Prescription& other)
        : n(other.n),
          medicines(n > 0 ? new string[n] : nullptr) {

        for (int i = 0; i < n; i++) {
            medicines[i] = other.medicines[i];
        }

        cout << "Copy constructor called" << endl;
    }

    // Copy assignment operator
    Prescription& operator=(const Prescription& other) {
        if (this != &other) {
            string* newMedicines =
                other.n > 0 ? new string[other.n] : nullptr;

            for (int i = 0; i < other.n; i++) {
                newMedicines[i] = other.medicines[i];
            }

            delete[] medicines;

            medicines = newMedicines;
            n = other.n;
        }

        return *this;
    }

    // Destructor
    ~Prescription() {
        delete[] medicines;
    }

    void set(int i, const string& medicine) {
        if (i < 0 || i >= n) {
            cout << "Invalid index" << endl;
            return;
        }

        medicines[i] = medicine;
    }

    string get(int i) const {
        if (i < 0 || i >= n) {
            return "";
        }

        return medicines[i];
    }

    void display() const {
        for (int i = 0; i < n; i++) {
            cout << medicines[i] << " ";
        }
        cout << endl;
    }
};

void passByValue(Prescription p) {
    cout << "Passed by value: ";
    p.display();
}

void passByReference(const Prescription& p) {
    cout << "Passed by reference: ";
    p.display();
}

int main() {
    Prescription p(2);

    p.set(0, "Paracetamol");
    p.set(1, "ORS");

    // Copy constructor
    Prescription q = p;

    q.set(1, "Cetirizine");

    // Copy assignment
    Prescription r(1);
    r = p;

    p.set(0, "Ibuprofen");

    cout << p.get(0) << " " << p.get(1)
         << " | " << q.get(0) << " " << q.get(1)
         << " | " << r.get(0) << " " << r.get(1) << endl;

    cout << "\nPassing by value:" << endl;
    passByValue(p);

    cout << "\nPassing by const reference:" << endl;
    passByReference(p);

    // Self-assignment
    cout << "\nSelf assignment:" << endl;
    p = p;
    p.display();

    // Vector alternative
    vector<string> medicines = {"Paracetamol", "ORS"};

    vector<string> copiedMedicines = medicines;

    copiedMedicines[1] = "Cetirizine";

    cout << "\nOriginal Vector: ";
    for (const string& medicine : medicines) {
        cout << medicine << " ";
    }

    cout << "\nCopied Vector: ";
    for (const string& medicine : copiedMedicines) {
        cout << medicine << " ";
    }

    cout << endl;

    return 0;
}
