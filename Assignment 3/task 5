#include <iostream>
#include <vector>
#include <string>
#include <stdexcept>
using namespace std;

class Time {
private:
    int totalSeconds;

public:
    Time(int hours = 0, int minutes = 0, int seconds = 0) {
        if (hours < 0 || minutes < 0 || seconds < 0) {
            throw invalid_argument("Invalid time");
        }

        totalSeconds = hours * 3600 + minutes * 60 + seconds;
    }

    // Prefix increment
    Time& operator++() {
        ++totalSeconds;
        return *this;
    }

    // Postfix increment
    Time operator++(int) {
        Time old = *this;

        ++(*this);

        return old;
    }

    // Equality operator
    bool operator==(const Time& other) const {
        return totalSeconds == other.totalSeconds;
    }

    // Less than operator
    bool operator<(const Time& other) const {
        return totalSeconds < other.totalSeconds;
    }

    void display() const {
        int hours = totalSeconds / 3600;
        int minutes = (totalSeconds % 3600) / 60;
        int seconds = totalSeconds % 60;

        cout << hours << ":";

        if (minutes < 10) cout << "0";
        cout << minutes << ":";

        if (seconds < 10) cout << "0";
        cout << seconds;
    }
};

class Playlist {
private:
    vector<string> tracks;

public:
    Playlist(initializer_list<string> songs)
        : tracks(songs) {}

    // Non-const subscript operator
    string& operator[](int index) {
        if (index < 0 || index >= (int)tracks.size()) {
            throw out_of_range("Playlist index out of range");
        }

        return tracks[index];
    }

    // Const subscript operator
    const string& operator[](int index) const {
        if (index < 0 || index >= (int)tracks.size()) {
            throw out_of_range("Playlist index out of range");
        }

        return tracks[index];
    }

    int size() const {
        return (int)tracks.size();
    }
};

int main() {
    Time t(0, 59, 58);

    Time a = t++;
    Time b = ++t;

    cout << "Value of a: ";
    a.display();

    cout << "\nValue of b: ";
    b.display();

    cout << "\nValue of t: ";
    t.display();

    cout << endl;

    // Time rollover
    Time rollover(0, 59, 59);

    ++rollover;

    cout << "After rollover: ";
    rollover.display();

    cout << endl;

    // Playlist
    Playlist playlist = {
        "Song One",
