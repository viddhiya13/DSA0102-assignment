#include <iostream>
using namespace std;

// 1. Call by value: changes only the local copy.
void concessionByValue(long long fee, int percent)
{
    fee -= fee * percent / 100;
}

// 2. Call by reference: changes the caller's variable.
void concessionByReference(long long& fee, int percent)
{
    fee -= fee * percent / 100;
}

// 3. Call by pointer: changes the value at the supplied address.
void concessionByPointer(long long* fee, int percent)
{
    if (fee != nullptr)
        *fee -= *fee * percent / 100;
}

// Supplied Predict the Output program
