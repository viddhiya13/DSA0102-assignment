
#include <iostream>
using namespace std;

// Compile-time constants
constexpr int INNER_FARE = 1000;
constexpr int MIDDLE_FARE = 2000;
constexpr int OUTER_FARE = 3000;

constexpr int PEAK_SURCHARGE_PERCENT = 20;
constexpr long long MIN_BALANCE_PAISE = 5000;

// Zone enumeration
enum class Zone
{
    Inner,
    Middle,
    Outer
};

// Fare calculation class
class FareTable
{
public:
    static long long calculateFare(Zone zone, bool peak)
    {
        long long fare = 0;

        switch (zone)
        {
            case Zone::Inner:
                fare = INNER_FARE;
                break;

            case Zone::Middle:
                fare = MIDDLE_FARE;
                break;

            case Zone::Outer:
                fare = OUTER_FARE;
                break;
        }

        if (peak)
        {
            fare += fare * PEAK_SURCHARGE_PERCENT / 100;
        }

        return fare;
    }
};

int main()
{
    Zone selectedZone = Zone::Inner;
    bool peakHour = false;

    cout << "NAMMA METRO FARE TABLE" << endl;

    cout << "Inner Zone Fare: Rs "
         << INNER_FARE / 100.0 << endl;

    cout << "Middle Zone Fare: Rs "
         << MIDDLE_FARE / 100.0 << endl;

    cout << "Outer Zone Fare: Rs "
         << OUTER_FARE / 100.0 << endl;

    cout << "Peak Surcharge: "
         << PEAK_SURCHARGE_PERCENT << "%" << endl;

    cout << "Minimum Balance: Rs "
         << MIN_BALANCE_PAISE / 100 << endl;

    cout << "\nCalculated Fare: Rs "
         << FareTable::calculateFare(selectedZone, peakHour) / 100.0
         << endl;

    selectedZone = Zone::Outer;
    peakHour = true;

    cout << "Peak Outer Fare: Rs "
         << FareTable::calculateFare(selectedZone, peakHour) / 100.0
         << endl;

    return 0;
}
