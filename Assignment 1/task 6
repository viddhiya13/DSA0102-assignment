
#include <iostream>
#include <iomanip>
using namespace std;

enum class Zone
{
    Inner,
    Middle,
    Outer
};

constexpr int BASE_PAISE[] = {
    1000, 2000, 3000
};

constexpr int PEAK_SURCHARGE_PERCENT = 20;
constexpr long long MIN_BALANCE_PAISE = 5000;

long long fare(Zone z, bool peak)
{
    long long baseFare = 0;

    switch (z)
    {
        case Zone::Inner:
            baseFare = BASE_PAISE[0];
            break;

        case Zone::Middle:
            baseFare = BASE_PAISE[1];
            break;

        case Zone::Outer:
            baseFare = BASE_PAISE[2];
            break;

        default:
            return -1;
    }

    if (peak)
    {
        baseFare +=
            baseFare * PEAK_SURCHARGE_PERCENT / 100;
    }

    return baseFare;
}

bool canTravel(long long balance, long long f)
{
    return f >= 0 &&
           balance >= f &&
           balance - f >= MIN_BALANCE_PAISE;
}

bool isPeakHour(int hour)
{
    return (hour >= 8 && hour < 10) ||
           (hour >= 17 && hour < 20);
}

int main()
{
    long long balance = 10000;

    struct Trip
    {
        Zone zone;
        int hour;
    };

    Trip trips[] =
    {
        {Zone::Inner, 7},
        {Zone::Outer, 9},
        {Zone::Middle, 14},
        {Zone::Inner, 10},
        {Zone::Outer, 20}
    };

    for (const Trip& t : trips)
    {
        bool peak = isPeakHour(t.hour);

        long long f = fare(t.zone, peak);

        if (canTravel(balance, f))
        {
            balance -= f;

            cout << "Fare Rs "
                 << f / 100 << "."
                 << setw(2) << setfill('0')
                 << f % 100 << setfill(' ');
        }
        else
        {
            cout << "Denied (low balance)";
        }

        cout << " balance Rs "
             << balance / 100 << "."
             << setw(2) << setfill('0')
             << balance % 100 << setfill(' ')
             << endl;
    }

    return 0;
}
