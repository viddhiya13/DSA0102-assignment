
#include <iostream>
#include <iomanip>
#include <limits>
#include <string>
using namespace std;

class SmartCard
{
private:
    long long balance;

public:
    SmartCard(long long amount)
        : balance(amount) {}

    bool deductFare(long long fare)
    {
        if (fare < 0 || balance - fare < 5000)
        {
            return false;
        }

        balance -= fare;
        return true;
    }

    long long getBalance() const
    {
        return balance;
    }
};

bool readInteger(const string& message, int& value)
{
    while (true)
    {
        cout << message;

        if (cin >> value)
        {
            return true;
        }

        if (cin.eof())
        {
            return false;
        }

        cout << "Invalid input. Enter a number." << endl;

        cin.clear();
        cin.ignore(
            numeric_limits<streamsize>::max(), '\n');
    }
}

int main()
{
    SmartCard card(20000);

    int numberOfJourneys;

    if (!readInteger("Enter number of journeys: ",
                     numberOfJourneys))
    {
        return 1;
    }

    if (numberOfJourneys < 0 || numberOfJourneys > 1000)
    {
        cout << "Invalid journey count." << endl;
        return 1;
    }

    cout << "\nNAMMA METRO JOURNEY REPORT" << endl;
    cout << "--------------------------------" << endl;

    for (int i = 1; i <= numberOfJourneys; i++)
    {
        int zone;
        int hour;

        if (!readInteger("Enter zone (1-3): ", zone))
        {
            return 1;
        }

        if (!readInteger("Enter hour (0-23): ", hour))
        {
            return 1;
        }

        if (zone < 1 || zone > 3 ||
            hour < 0 || hour > 23)
        {
            cout << "Invalid journey details. Skipped."
                 << endl;
            continue;
        }

        long long fare = zone * 1000LL;

        bool peak =
            (hour >= 8 && hour < 10) ||
            (hour >= 17 && hour < 20);

        if (peak)
        {
            fare += fare * 20 / 100;
        }

        cout << "\nJourney " << i << endl;

        cout << "Fare: Rs "
             << fixed << setprecision(2)
             << fare / 100.0 << endl;

        if (card.deductFare(fare))
        {
            cout << "Status: Approved" << endl;
        }
        else
        {
            cout << "Status: Denied" << endl;
        }

        cout << "Remaining Balance: Rs "
             << card.getBalance() / 100.0 << endl;
    }

    cout << "\nFINAL JOURNEY REPORT" << endl;
    cout << "--------------------------------" << endl;

    cout << "Final Balance: Rs "
         << fixed << setprecision(2)
         << card.getBalance() / 100.0 << endl;

    return 0;
}
