
#include <iostream>
#include <iomanip>
#include <string>
using namespace std;

constexpr long long MIN_BALANCE = 5000;
constexpr int PEAK_SURCHARGE = 20;

enum class Zone
{
    Inner = 1,
    Middle = 2,
    Outer = 3
};

class FareCalculator
{
public:
    static bool isValidZone(int zone)
    {
        return zone >= 1 && zone <= 3;
    }

    static bool isValidHour(int hour)
    {
        return hour >= 0 && hour <= 23;
    }

    static bool isPeakHour(int hour)
    {
        return (hour >= 8 && hour < 10) ||
               (hour >= 17 && hour < 20);
    }

    static long long calculateFare(int zone, int hour)
    {
        if (!isValidZone(zone) || !isValidHour(hour))
        {
            return -1;
        }

        long long fare = 0;

        switch (static_cast<Zone>(zone))
        {
            case Zone::Inner:
                fare = 1000;
                break;

            case Zone::Middle:
                fare = 2000;
                break;

            case Zone::Outer:
                fare = 3000;
                break;
        }

        if (isPeakHour(hour))
        {
            fare += fare * PEAK_SURCHARGE / 100;
        }

        return fare;
    }
};

class SmartCard
{
private:
    long long balance;

public:
    explicit SmartCard(long long initialBalance)
        : balance(initialBalance) {}

    bool recharge(long long amount)
    {
        if (amount <= 0 ||
            balance > 1000000000000LL - amount)
        {
            return false;
        }

        balance += amount;
        return true;
    }

    bool processJourney(long long fare)
    {
        if (fare < 0 ||
            balance < fare ||
            balance - fare < MIN_BALANCE)
        {
            return false;
        }

        balance -= fare;
        return true;
    }

    long long getBalance() const
    {
        return balance;
    }
};

int main()
{
    SmartCard card(20000);

    struct TestCase
    {
        int zone;
        int hour;
        long long expectedFare;
        string description;
    };

    TestCase tests[] =
    {
        {1, 7, 1000, "Inner Off-Peak"},
        {2, 12, 2000, "Middle Off-Peak"},
        {3, 14, 3000, "Outer Off-Peak"},
        {1, 8, 1200, "Exactly 8 AM"},
        {2, 10, 2000, "Exactly 10 AM"},
        {2, 17, 2400, "Exactly 5 PM"},
        {3, 20, 3000, "Exactly 8 PM"},
        {4, 12, -1, "Invalid Zone"},
        {1, 24, -1, "Invalid Hour"}
    };

    cout << "METRO FARE TESTING SYSTEM" << endl;
    cout << "-------------------------------------" << endl;

    for (const TestCase& test : tests)
    {
        long long actualFare =
            FareCalculator::calculateFare(
                test.zone, test.hour);

        bool passed = actualFare == test.expectedFare;

        cout << test.description << " : "
             << (passed ? "PASS" : "FAIL")
             << endl;

        cout << "Expected Fare: " << test.expectedFare
             << " Paise" << endl;

        cout << "Actual Fare: " << actualFare
             << " Paise" << endl;
    }

    cout << "\nFIVE JOURNEY CALCULATION" << endl;

    int zones[] = {1, 2, 3, 1, 2};
    int hours[] = {7, 8, 17, 20, 14};

    long long totalFare = 0;

    for (int i = 0; i < 5; i++)
    {
        long long f =
            FareCalculator::calculateFare(
                zones[i], hours[i]);

        cout << "Journey " << i + 1
             << " Fare: Rs "
             << fixed << setprecision(2)
             << f / 100.0 << endl;

        totalFare += f;
    }

    cout << "Total Fare: Rs "
         << totalFare / 100.0 << endl;

    cout << "\nNEGATIVE RECHARGE TEST" << endl;

    if (!card.recharge(-1000))
    {
        cout << "Negative recharge rejected." << endl;
    }

    cout << "\nFINAL BALANCE: Rs "
         << card.getBalance() / 100.0 << endl;

    return 0;
}
