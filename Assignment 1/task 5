
#include <iostream>
using namespace std;

int main()
{
    int x = 5;
    int y = 3;

    // Operator precedence
    cout << x + y * 2 << ' '
         << (x + y) * 2 << '\n';

    // Increment operators
    int z = x++ + ++y;

    cout << z << ' '
         << x << ' '
         << y << '\n';

    // Conditional operator and modulus
    cout << (x > y ? x : y) << ' '
         << x % 4 * 2 << '\n';

    // Division and remainder
    cout << 10 / 3 << ' '
         << 10 % 3 << ' '
         << -10 / 3 << ' '
         << -10 % 3 << '\n';

    // Compound assignment
    int k = 0;

    for (int i = 0; i < 10; i += 3)
    {
        k += i;
    }

    cout << k << '\n';

    // Peak hour calculation
    int hour;

    cout << "Enter hour: ";
    cin >> hour;

    bool peak =
        (hour >= 8 && hour < 10) ||
        (hour >= 17 && hour < 20);

    cout << "Peak Hour: "
         << boolalpha << peak << endl;

    // Surcharge calculation
    int fare = 3000;

    if (peak)
    {
        fare += fare * 20 / 100;
    }

    cout << "Fare in Paise: " << fare << endl;

    // Concession calculation
    bool student = true;

    if (student)
    {
        fare = fare * 80 / 100;
    }

    cout << "Final Fare in Paise: "
         << fare << endl;

    return 0;
}
